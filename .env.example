# Copy to .env in this folder. Every value is optional; the defaults are shown.
# .env is gitignored. Never commit real keys.

# --- Market data (public endpoints only, no exchange key is used in phase 1) ---
CSB_EXCHANGE=coinbaseexchange
CSB_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
CSB_BACKFILL_DAYS=730

# --- Paper account and cost model ---
CSB_STARTING_CASH=10000
CSB_FEE_BPS=40
CSB_SLIPPAGE_BPS=5

# --- Engine ---
CSB_CYCLE_SECONDS=60
CSB_NEWS_REFRESH_SECONDS=600
CSB_API_PORT=8787
CSB_DB_PATH=data/csb.sqlite3

# --- News scoring (off until the selected provider has a key and a model) ---
# Provider: openai or anthropic. Keys, model names, and OpenAI-compatible base URL
# are read from this file only, never from the shell environment.
CSB_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible API root (default: https://api.openai.com/v1).
# For OpenRouter, uncomment the next line and set OPENAI_API_KEY to your OpenRouter key.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Example OpenRouter model id: openai/gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
